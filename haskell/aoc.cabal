cabal-version:      2.4
name:               aoc
version:            0.1.0.0

author:             Ptkyr

common aoc
    build-depends:    base ^>=4.16.4.0
                      , aoc
                      , containers
                      , array
                      , template-haskell
                      , unordered-containers
                      , fgl
    default-language:   Haskell2010
    default-extensions: OverloadedStrings
                      , TupleSections
                      , ImportQualifiedPost
    hs-source-dirs: .
    ghc-options:       -Wall

library
    exposed-modules: Arrays, Dijkstra, Graphs, Mayn, Parsing, Utils
    build-depends:    base ^>=4.16.4.0
                      , megaparsec
                      , text
                      , array
                      , fingertree
                      , utility-ht
                      , composition
                      , template-haskell
                      , clock
                      , unordered-containers
                      , number-length
                      , criterion
                      , fgl
                      , split
    hs-source-dirs:   common
    default-language: Haskell2010
    default-extensions: OverloadedStrings
                      , TupleSections
                      , ImportQualifiedPost
    ghc-options:       -Wall

executable 2024_01
    import: aoc
    main-is: 2024/01.hs

